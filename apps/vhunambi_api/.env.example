# VHUNAMBI AI Music Synthesis API Gateway Configuration
PORT=3000
NODE_ENV=development

# RunPod Serverless GPU (ACE-Step Audio Generation)
# Reuses the existing ZR Studio endpoint — no new Docker image needed!
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# RunPod ComfyUI 9:16 Vision Generation (SDXL / FLUX.1 [schnell])
RUNPOD_COMFYUI_URL=
RUNPOD_COMFYUI_ENDPOINT_ID=

# Anthropic Claude & Grok (Story-to-Lyrics Generation)
ANTHROPIC_API_KEY=
GROK_API_KEY=
ZR_LLM_PROVIDER=claude

# Cloudflare R2 Audio Object Storage (dedicated vhunambi-audio bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=vhunambi-audio

# Webhook Authentication (HMAC-SHA256) — MUST match ZR Studio GPU worker's ZR_WEBHOOK_SECRET
ZR_WEBHOOK_SECRET=dev_webhook_secret_vhunambi_2026

# Public base URL for RunPod GPU callbacks (Phase 16: use cloudflared tunnel or ngrok)
# Run: cloudflared tunnel --url http://localhost:3000
# Then set this to the generated HTTPS URL (e.g. https://abc123.trycloudflare.com)
WEBHOOK_BASE_URL=http://localhost:3000
