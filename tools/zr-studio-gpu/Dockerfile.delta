# Fast delta image: only the Python worker modules change on top of vhunambi-v2.
# Build:  docker buildx build --provenance=false -f Dockerfile.delta -t ndugelo/zr-studio-gpu:vhunambi-v3 --push .
FROM ndugelo/zr-studio-gpu:vhunambi-v2
WORKDIR /app
COPY model_utils.py mmo_extractor.py stem_mastering_worker.py seed_vc_worker.py handler.py /app/
# Fail the build if the patched modules do not import cleanly.
RUN python -m py_compile /app/model_utils.py /app/stem_mastering_worker.py /app/handler.py
CMD [ "python", "-u", "/app/handler.py" ]

